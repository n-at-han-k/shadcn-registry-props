      "name": "font-fraunces",
      "type": "registry:font",
      "title": "Fraunces (font)",
      "description": "Display serif for titles, letters and cards.",
      "categories": [
        "font"
      ],
      "font": {
        "family": "'Fraunces', Georgia, serif",
        "provider": "google",
        "import": "Fraunces",
        "variable": "--font-display",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource/fraunces"
      }
    },
