{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "fewtone",
  "homepage": "https://ui.fewtone.com",
  "items": [
    {
      "name": "tokens",
      "type": "registry:lib",
      "title": "FewTone UI tokens",
      "description": "Sizes, motion durations, easing, focus ring and popover animations that FewTone UI components use. Adds only what your project does not define yet.",
      "author": "FewTone <https://fewtone.com>",
      "cssVars": {
        "theme": {
          "animate-popover-in": "popover-in var(--duration-fast) cubic-bezier(0.22, 1, 0.36, 1) both",
          "animate-popover-out": "popover-out var(--duration-instant) cubic-bezier(0.55, 0, 1, 0.45) both",
          "animate-collapsible-open": "collapsible-open var(--duration-slow) cubic-bezier(0.22, 1, 0.36, 1)",
          "animate-collapsible-close": "collapsible-close var(--duration-base) cubic-bezier(0.55, 0, 1, 0.45) both"
        },
        "light": {
          "size-control-sm": "2rem",
          "size-control-md": "2.25rem",
          "size-control-lg": "2.5rem",
          "size-icon-sm": "0.875rem",
          "size-icon-md": "1rem",
          "size-icon-lg": "1.25rem",
          "size-roll-fade": "0.25em",
          "size-roll-fade-x": "0.5em",
          "size-sheet-top-gap": "max(2.75rem, calc(env(safe-area-inset-top) + 0.5rem))",
          "size-sheet-max": "calc(100svh - max(2.75rem, calc(env(safe-area-inset-top) + 0.5rem)))",
          "size-sheet-inset-bottom": "calc(1rem + env(safe-area-inset-bottom))",
          "duration-instant": "80ms",
          "duration-fast": "150ms",
          "duration-base": "220ms",
          "duration-slow": "350ms",
          "duration-slower": "500ms",
          "z-overlay": "1200",
          "z-modal": "1300",
          "z-popover": "1400",
          "z-toast": "1500",
          "z-tooltip": "1600",
          "focus-ring-width": "2px",
          "focus-ring-offset": "2px",
          "opacity-disabled": "0.5",
          "ease-spring": "linear(0, 0.157, 0.48, 0.77, 0.97, 1.07, 1.1, 1.09, 1.05, 1.02, 1, 0.995, 1)",
          "destructive-foreground": "oklch(1 0 0)",
          "overlay": "color-mix(in oklch, oklch(0 0 0) 40%, transparent)"
        },
        "dark": {
          "destructive-foreground": "oklch(1 0 0)",
          "overlay": "color-mix(in oklch, oklch(0 0 0) 60%, transparent)"
        }
      },
      "css": {
        "@keyframes popover-in": {
          "from": {
            "opacity": "0",
            "filter": "blur(6px)",
            "transform": "scale(0.96)"
          },
          "to": {
            "opacity": "1",
            "filter": "blur(0)",
            "transform": "scale(1)"
          }
        },
        "@keyframes popover-out": {
          "from": {
            "opacity": "1",
            "filter": "blur(0)",
            "transform": "scale(1)"
          },
          "to": {
            "opacity": "0",
            "filter": "blur(6px)",
            "transform": "scale(0.96)"
          }
        },
        "@keyframes collapsible-open": {
          "from": {
            "height": "0",
            "opacity": "0",
            "filter": "blur(6px)"
          },
          "to": {
            "height": "var(--collapsible-height)",
            "opacity": "1",
            "filter": "blur(0)"
          }
        },
        "@keyframes collapsible-close": {
          "from": {
            "height": "var(--collapsible-height)",
            "opacity": "1",
            "filter": "blur(0)"
          },
          "to": {
            "height": "0",
            "opacity": "0",
            "filter": "blur(6px)"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          ":root": {
            "--duration-instant": "1ms",
            "--duration-fast": "1ms",
            "--duration-base": "1ms",
            "--duration-slow": "1ms",
            "--duration-slower": "1ms"
          }
        }
      }
    },
