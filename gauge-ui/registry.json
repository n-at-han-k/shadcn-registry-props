{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "gauge-ui",
  "homepage": "https://gauge-ui.dev",
  "items": [
    {
      "name": "gauge",
      "type": "registry:ui",
      "title": "Gauge",
      "description": "Composable SVG gauge primitives: track, arc, zones, ticks, tick fills, labels, needle, hub, dot, tooltip and value text, with optional spring or tween animation and nested gauges, as round dials or horizontal and vertical bars. No runtime dependencies.",
      "author": "Thordur <https://github.com/thordursk>",
      "categories": ["data-display", "charts"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "components/gauge/index.ts",
          "type": "registry:ui",
          "target": "@components/gauge/index.ts"
        },
        {
          "path": "components/gauge/gauge.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/gauge.tsx"
        },
        {
          "path": "components/gauge/linear.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/linear.tsx"
        },
        {
          "path": "components/gauge/inset.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/inset.tsx"
        },
        {
          "path": "components/gauge/context.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/context.tsx"
        },
        {
          "path": "components/gauge/arcs.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/arcs.tsx"
        },
        {
          "path": "components/gauge/ticks.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/ticks.tsx"
        },
        {
          "path": "components/gauge/text.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/text.tsx"
        },
        {
          "path": "components/gauge/needle.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/needle.tsx"
        },
        {
          "path": "components/gauge/dot.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/dot.tsx"
        },
        {
          "path": "components/gauge/tooltip.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/tooltip.tsx"
        },
        {
          "path": "components/gauge/control.tsx",
          "type": "registry:ui",
          "target": "@components/gauge/control.tsx"
        },
        {
          "path": "components/gauge/scale.ts",
          "type": "registry:ui",
          "target": "@components/gauge/scale.ts"
        },
        {
          "path": "components/gauge/math.ts",
          "type": "registry:ui",
          "target": "@components/gauge/math.ts"
        },
        {
          "path": "components/gauge/utils.ts",
          "type": "registry:ui",
          "target": "@components/gauge/utils.ts"
        },
        {
          "path": "components/gauge/transition.ts",
          "type": "registry:ui",
          "target": "@components/gauge/transition.ts"
        },
        {
          "path": "components/gauge/use-animated-value.ts",
          "type": "registry:ui",
          "target": "@components/gauge/use-animated-value.ts"
        }
      ],
      "docs": "Import everything from \"@/components/gauge\". Compose <Gauge value min max startAngle endAngle> with GaugeTrack, GaugeArc, GaugeZones, GaugeTicks, GaugeMarks, GaugeTickLabels, GaugeNeedle, GaugeHub, GaugeValue and GaugeText. Nest a whole gauge inside another with <GaugeInset x y scale value min max>, for a fuel dial under a speedometer or a second ring inside the first. For a straight bar use <LinearGauge value orientation length padding> in place of <Gauge>: every part but GaugeNeedle works inside it, <LinearGaugeInset> nests one in another gauge, and <GaugeControl orientation> makes it a slider. Add transition to <Gauge> to animate value changes: true for the default spring, or { type: \"spring\", visualDuration, bounce } / { type: \"tween\", duration, ease }. Design one visually at the studio and copy the generated code."
    }
