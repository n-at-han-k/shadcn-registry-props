{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pane",
  "homepage": "https://pane.theui.company",
  "items": [
    {
      "name": "pane-style",
      "type": "registry:style",
      "title": "Style",
      "description": "Base style for Pane. Installs the shared dependencies and the --pane-* design tokens — blur, saturation, tint, border, highlight and shadow — for light and dark, plus a zero-specificity --font-sans fallback to Geist for fresh Next.js apps.",
      "author": "Deniz Isik (https://github.com/denizisikzero)",
      "dependencies": [
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "motion",
        "lucide-react"
      ],
      "devDependencies": ["tw-animate-css"],
      "cssVars": {
        "light": {
          "pane-fg": "var(--foreground)",
          "pane-blur-thick": "12px",
          "pane-blur-regular": "5px",
          "pane-blur-thin": "0px",
          "pane-saturation": "1.7",
          "pane-tint-thick": "rgba(255, 255, 255, 0.26)",
          "pane-tint-regular": "rgba(255, 255, 255, 0.08)",
          "pane-tint-thin": "rgba(255, 255, 255, 0)",
          "pane-blur-overlay": "24px",
          "pane-tint-overlay": "rgba(255, 255, 255, 0.76)",
          "pane-nested-thick": "rgba(255, 255, 255, 0.4)",
          "pane-nested-regular": "rgba(255, 255, 255, 0.2)",
          "pane-nested-thin": "rgba(255, 255, 255, 0)",
          "pane-radius-scale": "1",
          "pane-rim": "1",
          "pane-border-width": "0.5px",
          "pane-border-thick": "rgba(255, 255, 255, 0.85)",
          "pane-border-regular": "rgba(255, 255, 255, 0.6)",
          "pane-border-thin": "rgba(255, 255, 255, 0.6)",
          "pane-accent": "#34c759",
          "pane-accent-foreground": "#ffffff",
          "pane-accent-opacity": "82%",
          "pane-accent-text": "#248a3d",
          "pane-border-accent": "rgba(255, 255, 255, 0.7)",
          "pane-destructive": "#ff3b30",
          "pane-destructive-text": "#d70015",
          "pane-tinted-opacity": "16%",
          "pane-knob": "rgba(255, 255, 255, 0.92)",
          "pane-highlight": "rgba(255, 255, 255, 0.85)",
          "pane-shadow": "rgba(0, 0, 0, 0.1)"
        },
        "dark": {
          "pane-fg": "var(--foreground)",
          "pane-tint-thick": "rgba(28, 28, 32, 0.3)",
          "pane-tint-regular": "rgba(18, 18, 22, 0.12)",
          "pane-tint-thin": "rgba(18, 18, 22, 0)",
          "pane-tint-overlay": "rgba(28, 28, 32, 0.76)",
          "pane-nested-thick": "rgba(255, 255, 255, 0.12)",
          "pane-nested-regular": "rgba(255, 255, 255, 0.07)",
          "pane-nested-thin": "rgba(255, 255, 255, 0)",
          "pane-border-thick": "rgba(255, 255, 255, 0.14)",
          "pane-border-regular": "rgba(255, 255, 255, 0.1)",
          "pane-border-thin": "rgba(255, 255, 255, 0.1)",
          "pane-accent": "#30d158",
          "pane-accent-foreground": "#ffffff",
          "pane-accent-opacity": "75%",
          "pane-accent-text": "#30db5b",
          "pane-border-accent": "rgba(255, 255, 255, 0.24)",
          "pane-destructive": "#ff453a",
          "pane-destructive-text": "#ff6961",
          "pane-tinted-opacity": "22%",
          "pane-knob": "rgba(255, 255, 255, 0.95)",
          "pane-highlight": "rgba(255, 255, 255, 0.22)",
          "pane-shadow": "rgba(0, 0, 0, 0.5)"
        }
      },
      "files": [],
      "css": {
        "@layer base": {
          ":where(html)": {
            "--font-sans": "var(--font-geist-sans, ui-sans-serif, system-ui, sans-serif)"
          }
        }
      }
