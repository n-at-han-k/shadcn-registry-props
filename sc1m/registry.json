{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "sc1m",
  "homepage": "https://sc1m.vercel.app",
  "items": [
    {
      "name": "tokens",
      "type": "registry:theme",
      "title": "sc1m Design Tokens",
      "description": "sc1m brand tokens and the Tailwind v4 theme contract: semantic colors, radii, shadows, motion, dark mode via the .dark class, and the popup-motion, ai-wash and ai-pulse utilities.",
      "cssVars": {
        "theme": {
          "--color-bg": "var(--bg)",
          "--color-surface": "var(--surface)",
          "--color-surface-raised": "var(--surface-raised)",
          "--color-fg": "var(--fg)",
          "--color-fg-muted": "var(--fg-muted)",
          "--color-fg-subtle": "var(--fg-subtle)",
          "--color-line": "var(--line)",
          "--color-line-strong": "var(--line-strong)",
          "--color-accent": "var(--accent)",
          "--color-accent-hover": "var(--accent-hover)",
          "--color-accent-fg": "var(--accent-fg)",
          "--color-highlight": "var(--highlight)",
          "--color-highlight-fg": "var(--highlight-fg)",
          "--color-success": "var(--success)",
          "--color-danger": "var(--danger)",
          "--color-danger-fg": "var(--danger-fg)",
          "--color-info": "var(--info)",
          "--color-warning": "var(--warning)",
          "--color-ring": "var(--ring)",
          "--font-sans": "var(--brand-font-sans, var(--font-geist-sans, ui-sans-serif))",
          "--font-mono": "var(--brand-font-mono, var(--font-geist-mono, ui-monospace))",
          "--radius-sm": "var(--brand-radius-sm, 0.25rem)",
          "--radius-md": "var(--brand-radius-md, 0.375rem)",
          "--radius-lg": "var(--brand-radius-lg, 0.5rem)",
          "--radius-xl": "var(--brand-radius-xl, 0.75rem)",
          "--shadow-raised": "var(--brand-shadow-raised, 0 1px 2px 0 rgb(0 0 0 / 0.05))",
          "--shadow-overlay": "var(--brand-shadow-overlay, 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1))",
          "--ease-out-quad": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
          "--duration-fast": "150ms"
        }
      },
      "css": {
        "@custom-variant dark (&:where(.dark, .dark *))": {},
        ":root": {
          "--n-0": "#ececec",
          "--n-50": "#f5f5f5",
          "--n-100": "#ebebeb",
          "--n-200": "#e5e5e5",
          "--n-300": "#d4d4d4",
          "--n-400": "#a3a3a3",
          "--n-500": "#8f8f8f",
          "--n-700": "#525252",
          "--n-900": "#0a0a0a",
          "--sc1m-orange": "#ff5a00",
          "--sc1m-paper": "#ffffff",
          "--bg": "var(--sc1m-paper)",
          "--surface": "var(--n-50)",
          "--surface-raised": "var(--sc1m-paper)",
          "--fg": "var(--n-900)",
          "--fg-muted": "var(--n-700)",
          "--fg-subtle": "var(--n-500)",
          "--line": "var(--n-200)",
          "--line-strong": "var(--n-300)",
          "--accent": "var(--sc1m-orange)",
          "--accent-hover": "#d94c00",
          "--accent-fg": "#ffffff",
          "--highlight": "var(--n-900)",
          "--highlight-fg": "#ffffff",
          "--ring": "var(--sc1m-orange)",
          "--brand-icon": "#ff5a00",
          "--brand-icon-fg": "#ffffff",
          "--success": "#16a34a",
          "--danger": "#dc2626",
          "--danger-fg": "#ffffff",
          "--info": "#2563eb",
          "--warning": "#d4a017",
          "--brand-radius-sm": "2px",
          "--brand-radius-md": "4px",
          "--brand-radius-lg": "8px",
          "--brand-radius-xl": "12px",
          "--brand-font-sans": "var(--font-geist-sans, ui-sans-serif)",
          "--brand-font-mono": "var(--font-geist-mono, ui-monospace)",
          "--acc-expand": "250ms",
          "--acc-collapse": "250ms",
          "--acc-chevron": "250ms",
          "--acc-ease": "cubic-bezier(0.22, 1, 0.36, 1)",
          "--acc-spring": "cubic-bezier(0.34, 1.36, 0.64, 1)",
          "--popup-open-dur": "250ms",
          "--popup-close-dur": "150ms",
          "--popup-pre-scale": "0.97",
          "--popup-closing-scale": "0.99",
          "--popup-ease": "cubic-bezier(0.22, 1, 0.36, 1)",
          "--ai-hue": "var(--color-info)",
          "--ai-hue-ink": "color-mix(in oklab, var(--ai-hue) 50%, var(--color-fg))"
        },
        ".dark": {
          "--n-0": "#0a0a0a",
          "--n-50": "#171717",
          "--n-100": "#1f1f1f",
          "--n-200": "#262626",
          "--n-300": "#333333",
          "--n-400": "#6b6b6b",
          "--n-500": "#8a8a8a",
          "--n-700": "#a3a3a3",
          "--n-900": "#f5f5f5",
          "--sc1m-orange": "#ff6a1a",
          "--sc1m-paper": "#0a0a0a",
          "--surface-raised": "var(--n-100)",
          "--accent-hover": "#ff8547",
          "--accent-fg": "#0a0a0a",
          "--highlight-fg": "#0a0a0a",
          "--danger-fg": "#0a0a0a",
          "--success": "#4ade80",
          "--danger": "#f87171",
          "--info": "#60a5fa",
          "--warning": "#facc15"
        },
        "@utility popup-motion": {
          "transform-origin": "var(--transform-origin)",
          "transition-property": "opacity, scale",
          "transition-duration": "var(--popup-close-dur)",
          "transition-timing-function": "var(--popup-ease)",
          "will-change": "opacity, scale",
          "&[data-open]": {
            "transition-duration": "var(--popup-open-dur)"
          },
          "&[data-starting-style]": {
            "scale": "var(--popup-pre-scale)",
            "opacity": "0"
          },
          "&[data-ending-style]": {
            "scale": "var(--popup-closing-scale)",
            "opacity": "0"
          },
          "@media (prefers-reduced-motion: reduce)": {
            "transition": "none"
          }
        },
        "@keyframes toast-nudge": {
          "50%": {
            "scale": "1.05"
          }
        },
        ".toast-nudge": {
          "animation": "toast-nudge 300ms var(--popup-ease)"
        },
        ".ai-wash": {
          "background-image": "linear-gradient(180deg, color-mix(in oklab, var(--ai-hue) 9%, var(--color-bg)) 0%, color-mix(in oklab, var(--ai-hue) 4%, var(--color-bg)) 66%, color-mix(in oklab, var(--ai-hue) 2%, var(--color-bg)) 100%)",
          "border-color": "color-mix(in oklab, var(--ai-hue) 16%, var(--color-line))"
        },
        "@keyframes ai-pulse-a": {
          "from": {
            "background-size": "44% 46%, 32% 38%, 24% 62%",
            "background-position": "34% -26%, 6% -18%, -7% 68%",
            "opacity": "0.55"
          },
          "to": {
            "background-size": "62% 58%, 22% 26%, 18% 44%",
            "background-position": "46% -10%, 20% 4%, 3% 84%",
            "opacity": "1"
          }
        },
        "@keyframes ai-pulse-b": {
          "from": {
            "background-size": "58% 34%, 20% 52%, 30% 30%",
            "background-position": "76% 122%, 106% 40%, 14% 118%",
            "opacity": "0.5"
          },
          "to": {
            "background-size": "40% 24%, 30% 34%, 46% 44%",
            "background-position": "62% 106%, 94% 22%, 26% 104%",
            "opacity": "1"
          }
        },
        ".ai-pulse": {
          "position": "relative",
          "isolation": "isolate"
        },
        ".ai-pulse::before, .ai-pulse::after": {
          "content": "\"\"",
          "position": "absolute",
          "inset": "-1px",
          "z-index": "-1",
          "border-radius": "inherit",
          "pointer-events": "none",
          "background-repeat": "no-repeat",
          "mask-image": "radial-gradient(115% 115% at 50% 50%, transparent 16%, #000 70%)"
        },
        ".ai-pulse::before": {
          "background-image": "radial-gradient(closest-side, color-mix(in oklab, var(--ai-hue) 54%, transparent), transparent), radial-gradient(closest-side, color-mix(in oklab, var(--ai-hue) 50%, transparent), transparent), radial-gradient(closest-side, color-mix(in oklab, var(--ai-hue) 58%, transparent), transparent)",
          "background-size": "52% 52%, 27% 32%, 21% 53%",
          "background-position": "40% -18%, 13% -7%, -2% 76%",
          "opacity": "0.78",
          "animation": "ai-pulse-a 5200ms ease-in-out infinite alternate"
        },
        ".ai-pulse::after": {
          "background-image": "radial-gradient(closest-side, color-mix(in oklab, var(--ai-hue) 60%, transparent), transparent), radial-gradient(closest-side, color-mix(in oklab, var(--ai-hue) 46%, transparent), transparent), radial-gradient(closest-side, color-mix(in oklab, var(--ai-hue) 64%, transparent), transparent)",
          "background-size": "49% 29%, 25% 43%, 38% 37%",
          "background-position": "69% 114%, 100% 31%, 20% 111%",
          "box-shadow": "inset 0 0 0 1px color-mix(in oklab, var(--ai-hue) 34%, transparent)",
          "opacity": "0.75",
          "animation": "ai-pulse-b 7100ms ease-in-out infinite alternate"
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".toast-nudge": {
            "animation": "none"
          },
          ".ai-pulse::before, .ai-pulse::after": {
            "animation": "none"
          },
          ".vf-drift, .vf-shimmer": {
            "animation": "none"
          }
        },
        "@keyframes vf-drift": {
          "from": {
            "transform": "translate3d(-14px, 6px, 0) scale(1.04)"
          },
          "to": {
            "transform": "translate3d(16px, -8px, 0) scale(1.09)"
          }
        },
        "@keyframes vf-shimmer": {
          "0%, 100%": {
            "opacity": "0.45"
          },
          "50%": {
            "opacity": "0.7"
          }
        },
        ".vf-drift": {
          "animation": "vf-drift 38s ease-in-out infinite alternate",
          "transform-origin": "50% 50%",
          "transform-box": "view-box"
        },
        ".vf-shimmer": {
          "animation": "vf-shimmer 11s ease-in-out infinite"
        },
        ".ai-mark": {
          "background-image": "linear-gradient(90deg, color-mix(in oklab, var(--accent) 82%, transparent), color-mix(in oklab, var(--accent) 62%, transparent))",
          "background-repeat": "no-repeat",
          "background-size": "100% 100%",
          "box-decoration-break": "clone",
          "-webkit-box-decoration-break": "clone"
        }
      },
      "docs": "sc1m tokens installed. App-level setup: (1) dark mode toggles via the .dark class on <html> (next-themes compatible); (2) wrap app content in a container with `isolation: isolate` so Base UI portalled popups stack above it; (3) keep `position: relative` on <body> for correct Base UI backdrop behavior in iOS Safari 26+; (4) additional brands scope tokens under [data-brand=\"\u2026\"] on <html>."
    },
