    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "stickies-theme",
      "type": "registry:item",
      "title": "Stickies theme",
      "description": "The six sticky-note colours, light and dark, as CSS variables and Tailwind tokens, and the sticky-shadow utility.",
      "cssVars": {
        "theme": {
          "color-sticky-paper": "var(--sticky-paper)",
          "color-sticky-header": "var(--sticky-header)",
          "color-sticky-edge": "var(--sticky-edge)",
          "color-sticky-ink": "var(--sticky-ink)",
          "color-sticky-meta": "var(--sticky-meta)"
        }
      },
      "css": {
        "@layer base": {
          "[data-sticky-color]": {
            "--sticky-paper": "#fdf6c8",
            "--sticky-header": "#f6e9a6",
            "--sticky-edge": "#e8d995",
            "--sticky-ink": "#3b3214",
            "--sticky-meta": "#9a8d5c"
          },
          "[data-sticky-color=\"blue\"]": {
            "--sticky-paper": "#ddedfb",
            "--sticky-header": "#c7dff6",
            "--sticky-edge": "#abc9ea",
            "--sticky-ink": "#1d3049",
            "--sticky-meta": "#6c86a5"
          },
          "[data-sticky-color=\"green\"]": {
            "--sticky-paper": "#def3d7",
            "--sticky-header": "#c8e9bd",
            "--sticky-edge": "#a9d69c",
            "--sticky-ink": "#22391c",
            "--sticky-meta": "#6e8e65"
          },
          "[data-sticky-color=\"pink\"]": {
            "--sticky-paper": "#fbe1ed",
            "--sticky-header": "#f5c9dd",
            "--sticky-edge": "#e7abc6",
            "--sticky-ink": "#4a1f31",
            "--sticky-meta": "#a06e85"
          },
          "[data-sticky-color=\"purple\"]": {
            "--sticky-paper": "#ede3fb",
            "--sticky-header": "#ddcdf6",
            "--sticky-edge": "#c5aee9",
            "--sticky-ink": "#33204d",
            "--sticky-meta": "#8973a7"
          },
          "[data-sticky-color=\"grey\"]": {
            "--sticky-paper": "#f2f2f1",
            "--sticky-header": "#e3e3e1",
            "--sticky-edge": "#cfcfcc",
            "--sticky-ink": "#2b2b2a",
            "--sticky-meta": "#8a8a87"
          },
          ".dark [data-sticky-color]": {
            "--sticky-paper": "#48421f",
            "--sticky-header": "#575027",
            "--sticky-edge": "#665d2f",
            "--sticky-ink": "#f7f0cb",
            "--sticky-meta": "#b9ad7a"
          },
          ".dark [data-sticky-color=\"blue\"]": {
            "--sticky-paper": "#1f3249",
            "--sticky-header": "#273d57",
            "--sticky-edge": "#324b68",
            "--sticky-ink": "#dcebfb",
            "--sticky-meta": "#8ea8c7"
          },
          ".dark [data-sticky-color=\"green\"]": {
            "--sticky-paper": "#223a20",
            "--sticky-header": "#2a4727",
            "--sticky-edge": "#355630",
            "--sticky-ink": "#ddf2d6",
            "--sticky-meta": "#90b087"
          },
          ".dark [data-sticky-color=\"pink\"]": {
            "--sticky-paper": "#48222f",
            "--sticky-header": "#572a39",
            "--sticky-edge": "#683446",
            "--sticky-ink": "#fbe0ec",
            "--sticky-meta": "#c493a8"
          },
          ".dark [data-sticky-color=\"purple\"]": {
            "--sticky-paper": "#34234d",
            "--sticky-header": "#3f2b5c",
            "--sticky-edge": "#4c366d",
            "--sticky-ink": "#ece2fb",
            "--sticky-meta": "#a996c6"
          },
          ".dark [data-sticky-color=\"grey\"]": {
            "--sticky-paper": "#2d2d2c",
            "--sticky-header": "#363635",
            "--sticky-edge": "#434341",
            "--sticky-ink": "#f0f0ee",
            "--sticky-meta": "#9d9d9a"
          }
        },
        "@utility sticky-shadow": {
          "--sticky-shade": "color-mix(in oklch, var(--sticky-ink) 55%, black)",
          "box-shadow": "inset 0 1px 0 color-mix(in oklch, white 50%, transparent), 0 0 0 0.5px color-mix(in oklch, var(--sticky-shade) 6%, transparent), 0 1px 1px color-mix(in oklch, var(--sticky-shade) 8%, transparent), 0 3px 6px -2px color-mix(in oklch, var(--sticky-shade) 8%, transparent), 0 10px 20px -8px color-mix(in oklch, var(--sticky-shade) 12%, transparent), 0 24px 44px -20px color-mix(in oklch, var(--sticky-shade) 16%, transparent)",
          "transition": "box-shadow 200ms cubic-bezier(0.23, 1, 0.32, 1), translate 200ms cubic-bezier(0.23, 1, 0.32, 1)",
          "&[data-lifted]": {
            "translate": "0 -2px",
            "box-shadow": "inset 0 1px 0 color-mix(in oklch, white 50%, transparent), 0 0 0 0.5px color-mix(in oklch, var(--sticky-shade) 6%, transparent), 0 2px 3px color-mix(in oklch, var(--sticky-shade) 6%, transparent), 0 8px 14px -4px color-mix(in oklch, var(--sticky-shade) 10%, transparent), 0 22px 36px -10px color-mix(in oklch, var(--sticky-shade) 16%, transparent), 0 44px 72px -24px color-mix(in oklch, var(--sticky-shade) 20%, transparent)"
          },
          ".dark &": {
            "box-shadow": "inset 0 1px 0 color-mix(in oklch, white 10%, transparent), 0 0 0 0.5px color-mix(in oklch, black 40%, transparent), 0 1px 2px color-mix(in oklch, black 30%, transparent), 0 6px 12px -4px color-mix(in oklch, black 35%, transparent), 0 20px 40px -16px color-mix(in oklch, black 45%, transparent)"
          },
          ".dark &[data-lifted]": {
            "box-shadow": "inset 0 1px 0 color-mix(in oklch, white 10%, transparent), 0 0 0 0.5px color-mix(in oklch, black 40%, transparent), 0 3px 6px color-mix(in oklch, black 30%, transparent), 0 14px 28px -8px color-mix(in oklch, black 40%, transparent), 0 40px 72px -24px color-mix(in oklch, black 55%, transparent)"
          }
        }
      },
      "author": "Stickies <https://stickies.live>",
      "docs": "See https://stickies.live/docs#stickies-theme for usage.",
      "categories": [
        "stickies"
      ]
    },
