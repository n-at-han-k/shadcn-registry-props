    {
      "name": "paper-theme",
      "type": "registry:theme",
      "title": "Paper Theme",
      "description": "Six paper types as CSS variables (Cream, Kraft, Ledger, Blueprint, Newsprint, Carbon), merged into your global CSS, plus the five Ephemera fonts. Also re-skins existing shadcn/ui components.",
      "categories": [
        "theme"
      ],
      "registryDependencies": [
        "https://ephemera.kerrshift.com/r/font-fraunces.json",
        "https://ephemera.kerrshift.com/r/font-ibm-plex-mono.json",
        "https://ephemera.kerrshift.com/r/font-courier-prime.json",
        "https://ephemera.kerrshift.com/r/font-caveat.json",
        "https://ephemera.kerrshift.com/r/font-anton.json"
      ]
    },
