  "items": [
    {
      "name": "frame12-tokens",
      "type": "registry:ui",
      "title": "FRAME/12 Design Tokens",
      "description": "Standalone FRAME/12 CSS custom properties for Paper Light and Flashback Dark colors, font stacks, 12/20/32px gutters, 2.5px ink stroke, and 12fps (83.33ms) pose timing.",
      "files": [
        {
          "path": "styles/frame12-tokens.css",
          "type": "registry:file",
          "target": "styles/frame12-tokens.css"
        }
      ]
    },
    {
      "name": "frame12-styles",
      "type": "registry:ui",
      "title": "FRAME/12 Styles & Tokens",
      "description": "FRAME/12 CSS custom properties, panel grammar, screentone fills, and motion on twos.",
      "files": [
        {
          "path": "styles/frame12.css",
          "type": "registry:file",
          "target": "styles/frame12.css"
        },
        {
          "path": "styles/frame12-tailwind.css",
          "type": "registry:file",
          "target": "styles/frame12-tailwind.css"
        }
      ]
    },
    {
      "name": "use-tempo",
      "type": "registry:hook",
      "title": "useTempo & Motion Resolver",
      "description": "Tempo context and the pure motion resolver (resolveMotion, useTempo, useResolvedMotion, useReducedMotion): one viewer preference (auto / 12 on twos / 60 smooth / 0 still) for every FRAME/12 animation, with OS reduced motion always winning.",
      "files": [
        {
          "path": "hooks/use-tempo.ts",
          "type": "registry:hook",
          "target": "hooks/use-tempo.ts"
        }
      ]
    },
    {
      "name": "use-on-twos",
      "type": "registry:hook",
      "title": "useOnTwos & Motion Hooks",
      "description": "12fps stepped motion hook (83.33ms poses), count-up tween, ResizeObserver size hook, and reduced-motion detection.",
      "registryDependencies": [
        "https://frame12.dev/r/use-tempo.json"
      ],
      "files": [
        {
          "path": "hooks/use-on-twos.ts",
          "type": "registry:hook",
          "target": "hooks/use-on-twos.ts"
        }
      ]
    },
    {
      "name": "font-dela-gothic-one",
      "type": "registry:font",
      "title": "Dela Gothic One (FRAME/12 Display Font)",
      "description": "Display typeface (--font-dela-gothic-one -> --font-f-display) for FRAME/12 storyboard titles and establishing KPI numerals.",
      "font": {
        "family": "'Dela Gothic One', 'f12DisplayFallback', 'f12DisplayFallbackDejaVu', sans-serif",
        "provider": "google",
        "import": "Dela_Gothic_One",
