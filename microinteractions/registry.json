        "@property --wd-dot": {
          "syntax": "'<length>'",
          "inherits": "true",
          "initial-value": "6px"
        },
        "@property --wd-pill": {
          "syntax": "'<length>'",
          "inherits": "true",
          "initial-value": "12px"
        },
