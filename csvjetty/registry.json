{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "csvjetty",
  "homepage": "https://www.csvjetty.com",
  "items": [
    {
      "name": "contact-csv-import",
      "type": "registry:block",
      "title": "CSV Contact Import",
      "description": "CSV contact upload with column mapping, validation, inline correction, and an account-free preview. MIT integration code for the hosted CSVJetty service.",
      "dependencies": [
        "csvjetty@^0.5.9"
      ],
      "registryDependencies": [
        "card",
        "table"
      ],
      "files": [
        {
          "path": "registry/new-york/contact-csv-import/contact-csv-import.jsx",
          "type": "registry:component"
        },
        {
          "path": "registry/new-york/contact-csv-import/contact-csv-import-demo.jsx",
          "type": "registry:component"
        },
        {
          "path": "registry/new-york/contact-csv-import/LICENSE",
          "type": "registry:file",
          "target": "~/docs/csvjetty-integration-LICENSE.txt"
        }
      ]
    }
  ]
}
