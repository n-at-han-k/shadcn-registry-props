    {
      "name": "use-glass-pointer",
      "type": "registry:hook",
      "title": "Glass Pointer",
      "description": "Tracks the pointer and the surface's position in the viewport, then writes the angle of the rim light straight to the node as a CSS custom property — spring-smoothed, and without costing a React render.",
      "author": "Deniz Isik (https://github.com/denizisikzero)",
      "dependencies": ["motion"],
      "registryDependencies": ["@pane/glass-core"],
      "files": [
        {
          "path": "registry/pane/hooks/use-glass-pointer.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "use-glass-support",
      "type": "registry:hook",
      "title": "Glass Support",
      "description": "Detects how much of the glass material the browser can actually render and honors prefers-reduced-transparency, so surfaces degrade to blur or to a flat tint instead of breaking.",
      "author": "Deniz Isik (https://github.com/denizisikzero)",
      "registryDependencies": ["@pane/glass-core"],
      "files": [
        {
          "path": "registry/pane/hooks/use-glass-support.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "pane",
      "type": "registry:ui",
      "title": "Pane",
