{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "turn",
  "homepage": "https://turnui.xyz",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "turn theme",
      "description": "Color tokens the turn components read. Optional: skip it if your own theme already defines them.",
      "cssVars": {
        "light": {
          "background": "#ffffff",
          "foreground": "#0a0a0a",
          "muted": "#f2f2ee",
          "muted-foreground": "#525252",
          "border": "rgb(0 0 0 / 0.12)",
          "primary": "#0a0a0a",
          "primary-foreground": "#fafaf5",
          "ring": "#0a0a0a"
        },
        "dark": {
          "background": "#000000",
          "foreground": "#efefe4",
          "muted": "#1a1a1a",
          "muted-foreground": "#a3a3a3",
          "border": "rgb(255 255 255 / 0.13)",
          "primary": "#efefe4",
          "primary-foreground": "#0a0a0a",
          "ring": "#efefe4"
        }
      }
    },
