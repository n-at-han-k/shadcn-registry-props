      "dependencies": [],
      "registryDependencies": ["popover"],
      "files": [
        {
          "path": "registry/hint.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "infinite-scroll",
      "type": "registry:ui",
      "title": "Infinite Scroll",
      "description": "A list that loads more items as you scroll, down or up, with any data library",
      "dependencies": ["@base-ui/react"],
      "registryDependencies": ["spinner"],
      "files": [
        {
          "path": "registry/infinite-scroll.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "marquee",
      "type": "registry:ui",
      "title": "Marquee",
      "description": "A CSS-only strip that loops its items once they overflow",
      "dependencies": [],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/marquee.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "animate-marquee": "marquee var(--marquee-duration, 40s) linear infinite",
          "animate-marquee-reverse": "marquee var(--marquee-duration, 40s) linear infinite reverse",
          "animate-marquee-vertical": "marquee-vertical var(--marquee-duration, 40s) linear infinite",
          "animate-marquee-overflow": "marquee-overflow linear both"
        }
      },
      "css": {
        "@keyframes marquee": {
          "to": {
            "transform": "translateX(-50%)"
          }
        },
        "@keyframes marquee-vertical": {
          "to": {
            "transform": "translateY(-50%)"
          }
        },
        "@keyframes marquee-overflow": {
          "from, to": {
            "--marquee-overflowing": "1"
          }
        }
      }
    },
    {
      "name": "item-inset-separator",
      "type": "registry:ui",
      "title": "Item Inset Separator",
      "description": "A divider under an Item that starts at its content, past the media",
      "registryDependencies": ["item"],
      "files": [
        {
          "path": "registry/item-inset-separator.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
