    {
      "name": "prism-glass",
      "type": "registry:component",
      "title": "Prism Glass",
      "description": "A GPU-accelerated refractive lens for images and rendered textures. Spectral dispersion, uniform frost and a directional rim light, from an SDF-defined shape \u2014 no 3D model required. It refracts the texture you give it, not the DOM behind it.",
      "dependencies": [
        "three",
        "@react-three/fiber",
        "@react-three/drei",
        "maath"
      ],
      "files": [
        {
          "path": "packages/prism-glass/src/index.js",
          "type": "registry:component",
          "target": "components/prism-glass/index.js"
        },
